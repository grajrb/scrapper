# Copy this file to ".env" and adjust values if needed.
# The real .env file is git-ignored and must NEVER be committed.
# Phase 1 requires no credentials at all; these are optional overrides.

# Logging level: DEBUG, INFO, WARNING, ERROR
JOB_SEARCH_LOG_LEVEL=INFO

# Database location (relative to project root or absolute)
# JOB_SEARCH_DB_PATH=data/jobs.db

# --- Reserved for Phase 7 (optional notification channels) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# DISCORD_WEBHOOK_URL=
# SLACK_WEBHOOK_URL=
